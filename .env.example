# Copy to .env (Git ignored) and fill in from Supabase → Project Settings → API Keys / Data API.
# Leave both blank to keep the local-only JSON mode.
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (or legacy "anon") key. Never put the secret/service_role key here.
SUPABASE_PUBLISHABLE_KEY=
