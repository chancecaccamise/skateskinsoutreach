{
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api?__path=:path*" }],
  "functions": { "api/index.mjs": { "maxDuration": 60, "includeFiles": "lib/playbook.json" } },
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'" }
    ]
  }]
}
